(Install systemd service - First time only)
sudo ln -sf $GLIB/ground/systemd/tof-bridge.service /etc/systemd/system/
sudo systemctl daemon-reload
sudo systemctl enable tof-bridge

(Check MQTT/MySQL)
systemctl status mosquitto
systemctl status mysql

(Run Setup)
source grams_tof_ground_env.sh
sudo -E python3 $GLIB/ground/bin/setup_db.py

(Run bridge)
sudo systemctl daemon-reload
sudo systemctl restart tof-bridge

(Monitor)
systemctl status tof-bridge
tail -f $GLIB/ground/log/proc.log

(Check Histograms and Logs)
mysql -u pgrams_user -p -D grams_tof -e "SELECT hname, COUNT(*) FROM tof_monitor GROUP BY hname;"
mysql -u pgrams_user -p -D grams_tof -e "SELECT level_str, component, message, timestamp FROM tof_logs ORDER BY id DESC LIMIT 10;"

(Wipe current data)
mysql -u pgrams_user -p -D grams_tof -e "TRUNCATE TABLE tof_monitor;"
mysql -u pgrams_user -p -D grams_tof -e "TRUNCATE TABLE tof_logs;"
